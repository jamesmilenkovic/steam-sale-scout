.DS_Store

# Working scratch. Increments 9 and 10 committed their probe scripts here, so
# the directory still holds tracked files; this rule stops NEW scratch joining
# them by way of a `git add -A` (increment 13 review, SEC-12). Anything worth
# keeping is added deliberately with `git add -f`.
scratchpad/

# Agent worktrees. Each is a full second checkout of this repo at whatever commit
# the agent branched from, so a `git add -A` here can resurrect files a later
# increment deleted - increment 14's review caught exactly that (CR-2 / SEC-3).
.claude/worktrees/
